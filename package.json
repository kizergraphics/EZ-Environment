{
  "name": "ez-environment",
  "version": "1.2.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kizergraphics/EZ-Environment.git"
  },
  "homepage": "https://kizergraphics.github.io/EZ-Environment/",
  "bugs": {
    "url": "https://github.com/kizergraphics/EZ-Environment/issues"
  },
  "type": "module",
  "main": "build/ez-tree.umd.js",
  "module": "build/ez-tree.es.js",
  "exports": {
    ".": {
      "import": "./build/ez-tree.es.js",
      "require": "./build/ez-tree.umd.js"
    }
  },
  "files": [
    "build",
    "src",
    "LICENSE",
    "package.json",
    "README.md"
  ],
  "types": "./build/ez-tree.es.d.ts",
  "scripts": {
    "assets:prepare": "node scripts/desktop-prepare.mjs",
    "predev": "npm run assets:prepare",
    "prebuild:app": "npm run assets:prepare",
    "predesktop:dev": "npm run assets:prepare",
    "dev": "vite --config vite.app.config.js",
    "build:app": "vite build --config vite.app.config.js",
    "build:lib": "vite build --config vite.lib.config.js",
    "build:watch": "vite build --config vite.lib.config.js --watch",
    "app": "npm run build:lib && vite --config vite.app.config.js",
    "preview": "vite preview --config vite.app.config.js",
    "desktop:dev": "node scripts/desktop-dev.mjs",
    "desktop:start": "electron desktop/main.cjs",
    "desktop:pack": "npm run build:lib && npm run build:app && electron-builder --config electron-builder.config.cjs --win portable --x64 --publish never",
    "desktop:dir": "npm run build:lib && npm run build:app && electron-builder --config electron-builder.config.cjs --win dir --x64 --publish never",
    "test:desktop": "node --test desktop/security.test.cjs",
    "test:desktop:smoke": "node scripts/desktop-smoke.mjs",
    "test:desktop:portable": "node scripts/desktop-portable-smoke.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@typescript/typescript6": "^6.0.2",
    "@types/three": "^0.169.0",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "prettier": "3.3.3",
    "three": "^0.167.x",
    "vite": "^8.2.2",
    "vite-plugin-dts": "^5.1.0",
    "vite-plugin-static-copy": "^4.1.1"
  },
  "peerDependencies": {
    "three": ">=0.167"
  },
  "keywords": [
    "threejs",
    "three-js",
    "procedural",
    "generation",
    "tree"
  ]
}
